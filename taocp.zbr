# taocp -- algorithms from D. E. Knuth, *The Art of Computer Programming*.
#
# Each one names its volume and section and keeps Knuth's step labels (E1, H2, ...) in the
# comments, so it can be read beside the book. Where the book states an invariant or a
# precondition, it is a contract here (`require` / `ensure` / `invariant`): checked in an
# ordinary build, stripped by `--turbo`.
#
# Why TAOCP (zebra-language, docs/NEXT_STEPS_to_1.0.md, "the oracle argument"): these have
# behaviour defined OUTSIDE this repository -- published outputs, worked examples, counts
# with closed forms -- so a wrong answer is wrong by Knuth's account, not ours.
#
# Indices are 0-based, as Zebra lists are; where the book's 1-based subscripts make a step
# clearer, the code keeps them and subtracts one at the access (`k[j - 1]` for K_j).

# ── Vol. 2 §3.6: the subtractive lagged-Fibonacci generator `ran_array` ──────────────────
#
# X_j = (X_{j-100} - X_{j-37}) mod 2^30, seeded by `ran_start`. This is a Zebra rendering of
# the method Knuth publishes as rng.c (the 9th-printing / 2002 version; the test values are
# from its 2019 main program). It is a translation of the ALGORITHM, credited to Knuth --
# not his rng.c, which he asks be copied only unchanged.

const RAN_KK = 100            # the long lag
const RAN_LL = 37             # the short lag
const RAN_MM = 1073741824     # the modulus, 2^30
const RAN_TT = 70             # guaranteed separation between streams
const RAN_QUALITY = 1009      # Knuth's recommended block size for ran_arr_next

# Subtraction mod 2^30 -- two's complement makes the mask exact for a negative difference.
def ranModDiff(x: int, y: int): int
    return (x - y) & (RAN_MM - 1)

class RanArray
    var x: List(int)          # ran_x: the generator state, RAN_KK values
    var arr: List(int)        # ran_arr_buf, for next()
    var ptr: int              # index of the next unread value in arr; -1 = refill

    invariant
        .x.count() == RAN_KK

    # ran_start. Knuth: the seed selects one of 2^30 - 2 streams, and different seeds give
    # streams that do not overlap for at least 2^70 values.
    cue init(seed: int)
        require
            seed >= 0
            seed < RAN_MM - 2
        .x = List(int)()
        for i in 0 : RAN_KK
            .x.add(0)
        .arr = List(int)()
        for i in 0 : RAN_QUALITY
            .arr.add(0)
        .ptr = -1
        var buf = List(int)()               # the preparation buffer, KK+KK-1 values
        for i in 0 : RAN_KK + RAN_KK - 1
            buf.add(0)
        var ss: int = (seed + 2) & (RAN_MM - 2)
        for j in 0 : RAN_KK
            buf[j] = ss                     # bootstrap the buffer
            ss = ss << 1
            if ss >= RAN_MM                 # cyclic shift 29 bits
                ss -= RAN_MM - 2
        buf[1] += 1                         # make buf[1] (and only buf[1]) odd
        ss = seed & (RAN_MM - 1)
        var t: int = RAN_TT - 1
        while t > 0
            var sq: int = RAN_KK - 1        # "square"
            while sq > 0
                buf[sq + sq] = buf[sq]
                buf[sq + sq - 1] = 0
                sq -= 1
            var rd: int = RAN_KK + RAN_KK - 2
            while rd >= RAN_KK
                buf[rd - (RAN_KK - RAN_LL)] = ranModDiff(buf[rd - (RAN_KK - RAN_LL)], buf[rd])
                buf[rd - RAN_KK] = ranModDiff(buf[rd - RAN_KK], buf[rd])
                rd -= 1
            if (ss & 1) == 1                # "multiply by z"
                var sh: int = RAN_KK
                while sh > 0                # shift the buffer cyclically
                    buf[sh] = buf[sh - 1]
                    sh -= 1
                buf[0] = buf[RAN_KK]
                buf[RAN_LL] = ranModDiff(buf[RAN_LL], buf[RAN_KK])
            if ss != 0
                ss = ss >> 1
            else
                t -= 1
        for j in 0 : RAN_LL
            .x[j + RAN_KK - RAN_LL] = buf[j]
        for j in RAN_LL : RAN_KK
            .x[j - RAN_LL] = buf[j]
        for i in 0 : 10                     # warm things up
            .fill(buf, RAN_KK + RAN_KK - 1)

    # ran_array: put n new random numbers in aa[0..n). Knuth recommends n >= 1000 and using
    # only some of each block (see next()).
    def fill(aa: List(int), n: int)
        require
            n >= RAN_KK
            aa.count() >= n
        for j in 0 : RAN_KK
            aa[j] = .x[j]
        for j in RAN_KK : n
            aa[j] = ranModDiff(aa[j - RAN_KK], aa[j - RAN_LL])
        var j: int = n
        for i in 0 : RAN_LL
            .x[i] = ranModDiff(aa[j - RAN_KK], aa[j - RAN_LL])
            j += 1
        for i in RAN_LL : RAN_KK
            .x[i] = ranModDiff(aa[j - RAN_KK], .x[i - RAN_LL])
            j += 1

    # ran_arr_next (exercise 3.6-15): one value at a time. Each refill generates RAN_QUALITY
    # values and hands out only the first RAN_KK, which is the point -- Knuth's advice for
    # high-resolution use.
    def next(): int
        ensure
            result >= 0
            result < RAN_MM
        if .ptr >= 0
            if .arr[.ptr] >= 0
                var v: int = .arr[.ptr]
                .ptr += 1
                return v
        .fill(.arr, RAN_QUALITY)
        .arr[RAN_KK] = -1
        .ptr = 1
        return .arr[0]

# ── Vol. 1 §1.1: Algorithm E, Euclid's algorithm ─────────────────────────────────────────
def gcd(m: int, n: int): int
    require
        m > 0
        n > 0
    ensure
        result > 0
        m % result == 0
        n % result == 0
    var a: int = m
    var b: int = n
    while true
        var r: int = a % b                  # E1. [Find remainder.]
        if r == 0                           # E2. [Is it zero?]
            return b
        a = b                               # E3. [Reduce.]
        b = r

# ── Vol. 2 §4.5.2: Algorithm B, binary gcd ───────────────────────────────────────────────
# Stein's algorithm, in Knuth's six steps: subtraction and halving only, no division.
def binaryGcd(u0: int, v0: int): int
    require
        u0 > 0
        v0 > 0
    ensure
        result > 0
        u0 % result == 0
        v0 % result == 0
    var u: int = u0
    var v: int = v0
    var k: int = 0
    while (u & 1) == 0 and (v & 1) == 0     # B1. [Find power of 2.]
        k += 1
        u = u >> 1
        v = v >> 1
    var t: int = 0                          # B2. [Initialize.]
    if (u & 1) == 1
        t = 0 - v
    else
        t = u
    while true
        while (t & 1) == 0                  # B3/B4. [Halve t.] [Is t even?]
            t = t / 2                       # exact: t is even, and may be negative
        if t > 0                            # B5. [Reset max(u, v).]
            u = t
        else
            v = 0 - t
        t = u - v                           # B6. [Subtract.]
        if t == 0
            return u << k

# ── Vol. 2 §4.6.3: Algorithm A, right-to-left binary method for exponentiation ───────────
# x^n mod m. Invariant (Knuth): x^n = Y * Z^N at step A2. The modulus keeps every product
# below 2^62, so m must be under 2^31.
def powMod(x: int, n: int, m: int): int
    require
        n >= 0
        m >= 1
        m < 2147483648
    ensure
        result >= 0
        result < m
    var nn: int = n                         # A1. [Initialize.]
    var y: int = 1 % m
    var z: int = ((x % m) + m) % m
    while nn > 0
        var t: int = nn % 2                 # A2. [Halve N.]
        nn = nn / 2
        if t == 1
            y = (z * y) % m                 # A3. [Multiply Y by Z.]
            if nn == 0                      # A4. [N = 0?]
                return y
        z = (z * z) % m                     # A5. [Square Z.]
    return y

# ── Vol. 3 §5.2.1: Algorithm S, straight insertion ───────────────────────────────────────
def insertionSort(k: List(int))
    ensure
        isSorted(k)
    for j in 1 : k.count()                  # S1. [Loop on j.] (0-based: K_2 .. K_N)
        var key: int = k[j]                 # S2. [Set up i, K, R.]
        var i: int = j - 1
        while i >= 0 and key < k[i]         # S3. [Compare K : K_i.]
            k[i + 1] = k[i]                 # S4. [Move R_i, decrease i.]
            i -= 1
        k[i + 1] = key                      # S5. [R into R_{i+1}.]

# ── Vol. 3 §5.2.2: Algorithm Q, quicksort ────────────────────────────────────────────────
# Partition-exchange with Knuth's small-subfile cutoff: subfiles of M or fewer records are
# left for one straight-insertion pass at the end (Q9). Knuth finds M = 9 best on MIX; M = 1
# is pure quicksort. The larger subfile always goes on the stack, so the stack stays under
# lg N entries. K_{N+1} = +infinity is Knuth's sentinel for step Q3; here the scan is bounded
# by r instead, which stops at the same place.
def quickSortM(k: List(int), m: int)
    require
        m >= 1
    ensure
        isSorted(k)
    var n: int = k.count()
    if n > m                                # Q1. [Initialize.]
        var stack = List(int)()             # pairs (l, r), 1-based
        var l: int = 1
        var r: int = n
        while true
            var i: int = l                  # Q2. [Begin new stage.]
            var j: int = r + 1
            var key: int = k[l - 1]
            while true
                i += 1                      # Q3. [Compare K_i : K.]
                while i <= r and k[i - 1] < key
                    i += 1
                j -= 1                      # Q4. [Compare K : K_j.]
                while key < k[j - 1]
                    j -= 1
                if j <= i                   # Q5. [Test i : j.]
                    var t5: int = k[l - 1]
                    k[l - 1] = k[j - 1]
                    k[j - 1] = t5
                    break
                var t6: int = k[i - 1]      # Q6. [Exchange.]
                k[i - 1] = k[j - 1]
                k[j - 1] = t6
            # Q7. [Put on stack.] R_j is in its final place; the larger side is stacked.
            var popped: bool = false
            if r - j >= j - l and j - l > m
                stack.add(j + 1)
                stack.add(r)
                r = j - 1
            else if j - l > r - j and r - j > m
                stack.add(l)
                stack.add(j - 1)
                l = j + 1
            else if r - j > m and m >= j - l
                l = j + 1
            else if j - l > m and m >= r - j
                r = j - 1
            else
                popped = true
            if popped                       # Q8. [Take off stack.]
                if stack.count() == 0
                    break
                # pop() throws on an empty list; the stack holds (l, r) pairs and was just
                # checked non-empty, so the catch cannot fire
                r = stack.pop() catch 0
                l = stack.pop() catch 0
    if m > 1                                # Q9. [Straight insertion sort.]
        insertionSort(k)

def quickSort(k: List(int))
    ensure
        isSorted(k)
    quickSortM(k, 9)

# ── Vol. 4A §7.2.1.1: Algorithm G, Gray binary generation ────────────────────────────────
# The 2^n n-bit codes in Gray order, each differing from the last in exactly one bit, as
# integers (bit j = a_j). Knuth's loopless parity rule picks the bit to flip.
def grayCodes(n: int): List(int)
    require
        n >= 1
        n <= 30
    ensure
        result.count() == (1 << n)
    var out = List(int)()
    var a: int = 0                          # G1. [Initialize.] a_{n-1} .. a_0, as bits
    var parity: int = 0                     # a_infinity
    while true
        out.add(a)                          # G2. [Visit.]
        parity = 1 - parity                 # G3. [Change parity.]
        var j: int = 0                      # G4. [Choose j.]
        if parity == 0
            j = 1
            while ((a >> (j - 1)) & 1) == 0  # j - 1 = the position of the rightmost 1
                j += 1
        if j == n                           # G5. [Complement coordinate j.]
            break
        a = a ^ (1 << j)
    return out

# ── Vol. 3 §5.2.3: Algorithm H, heapsort ─────────────────────────────────────────────────
# Sorts k in place into nondecreasing order. N log N in the worst case, in place.
def heapSort(k: List(int))
    ensure
        isSorted(k)
    var n: int = k.count()
    if n < 2
        return
    var l: int = n / 2 + 1                  # H1. [Initialize.]
    var r: int = n
    while true
        var key: int = 0
        if l > 1                            # H2. [Decrease l or r.]
            l -= 1
            key = k[l - 1]
        else
            key = k[r - 1]
            k[r - 1] = k[0]
            r -= 1
            if r == 1
                k[0] = key
                return
        var j: int = l                      # H3. [Prepare for siftup.]
        var i: int = j
        while true
            i = j                           # H4. [Advance downward.]
            j = j + j
            if j < r                        # H5. [Find larger child.]
                if k[j - 1] < k[j]
                    j += 1
            else if j > r
                break
            if key >= k[j - 1]              # H6. [Larger than K?]
                break
            k[i - 1] = k[j - 1]             # H7. [Move it up.]
        k[i - 1] = key                      # H8. [Store R.]

def isSorted(k: List(int)): bool
    for i in 1 : k.count()
        if k[i - 1] > k[i]
            return false
    return true

# ── Vol. 3 §6.2.1: Algorithm B, binary search ────────────────────────────────────────────
# The index of `key` in the sorted list k, or -1.
#
# The precondition costs O(N) on an O(log N) search: an ordinary build is linear here, a
# `--turbo` build logarithmic. Kept, because a binary search over unsorted keys answers
# confidently and wrongly -- but it is the first place a contract's cost exceeds the
# algorithm's, which is what a complexity annotation would need to say.
def binarySearch(k: List(int), key: int): int
    require
        isSorted(k)
    ensure
        result == -1 or k[result] == key
    var l: int = 1                          # B1. [Initialize.]
    var u: int = k.count()
    while u >= l                            # B2. [Get midpoint.]
        var i: int = (l + u) / 2
        if key < k[i - 1]                   # B3. [Compare.]
            u = i - 1                       # B4. [Adjust u.]
        else if key > k[i - 1]
            l = i + 1                       # B5. [Adjust l.]
        else
            return i - 1                    # found
    return -1                               # unsuccessful

# ── Vol. 4A §7.2.1.2: Algorithm L, lexicographic permutation generation ─────────────────
# Steps a to the next permutation in lexicographic order and answers true, or answers false
# when a is already the last. Starting from a sorted list it visits every permutation once;
# a list with repeated values (a multiset) gets each DISTINCT permutation once.
def nextPermutation(a: List(int)): bool
    var n: int = a.count()
    var j: int = n - 2                      # L2. [Find j.]
    while j >= 0 and a[j] >= a[j + 1]
        j -= 1
    if j < 0
        return false
    var l: int = n - 1                      # L3. [Increase a_j.]
    while a[j] >= a[l]
        l -= 1
    var tmp: int = a[j]
    a[j] = a[l]
    a[l] = tmp
    var lo: int = j + 1                     # L4. [Reverse a_{j+1} ... a_n.]
    var hi: int = n - 1
    while lo < hi
        tmp = a[lo]
        a[lo] = a[hi]
        a[hi] = tmp
        lo += 1
        hi -= 1
    return true

# ── Vol. 4B §7.2.2.1: Algorithm X, exact cover via dancing links ─────────────────────────
#
# Items 1..N, of which 1..primary must each be covered EXACTLY once and the rest (secondary)
# AT MOST once. An option is a list of items; a solution is a set of options covering every
# primary item exactly once. Knuth's array layout, unchanged: nodes 0..N are the item
# headers (TOP of a header is its LEN, the number of live options using it), node N+1 is
# the first spacer, and each option's nodes are followed by a spacer whose TOP is -M (M the
# option's 1-based number) and whose ULINK / DLINK reach back to the first node of the
# option before it and forward to the last node of the option after it. The primary items
# form a circular list headed by 0; the secondary ones a second circle headed by N+1, so
# step X3 never chooses one.
#
# Algorithm C (§7.2.2.1, "color controls") is built in: a secondary item in an option may
# carry a COLOR, and a solution may then use that item in any number of chosen options as
# long as they all give it the SAME color (an uncolored use still means "at most once").
# With no colors the code below IS Algorithm X: hide/unhide skip only purified nodes
# (COLOR < 0), and commit/uncommit reduce to cover/uncover.
class ExactCover
    var primary: int
    var items: int            # N
    var llink: List(int)      # item lists, 0..N+1
    var rlink: List(int)
    var top: List(int)        # nodes: TOP (LEN, for a header)
    var ulink: List(int)
    var dlink: List(int)
    var color: List(int)      # nodes: COLOR (0 none, > 0 a color, -1 purified during search)
    var options: int          # M
    var last_spacer: int      # Z

    cue init(primary: int, secondary: int)
        require
            primary >= 1
            secondary >= 0
        .primary = primary
        .items = primary + secondary
        var n: int = .items
        .llink = List(int)()
        .rlink = List(int)()
        for i in 0 : n + 2
            .llink.add(0)
            .rlink.add(0)
        for i in 1 : primary + 1            # the primary circle, headed by 0
            .llink[i] = i - 1
            .rlink[i - 1] = i
        .llink[0] = primary
        .rlink[primary] = 0
        .llink[n + 1] = n + 1               # the secondary circle, headed by N+1
        .rlink[n + 1] = n + 1
        if secondary > 0
            # linked from primary+2 on: starting at primary+1 would set rlink[primary] and
            # cut the primary circle loose from its header (X3 then never returns to 0)
            for i in primary + 2 : n + 1
                .llink[i] = i - 1
                .rlink[i - 1] = i
            .llink[primary + 1] = n + 1
            .rlink[n + 1] = primary + 1
            .llink[n + 1] = n
            .rlink[n] = n + 1
        .top = List(int)()
        .ulink = List(int)()
        .dlink = List(int)()
        .color = List(int)()
        for i in 0 : n + 1                  # empty vertical lists: LEN 0, links to self
            .top.add(0)
            .ulink.add(i)
            .dlink.add(i)
            .color.add(0)
        .top.add(0)                         # node N+1, the first spacer
        .ulink.add(0)
        .dlink.add(0)
        .color.add(0)
        .options = 0
        .last_spacer = n + 1

    # One option: its items, each 1..N, with no item twice.
    def addOption(its: List(int))
        var none = List(int)()
        for i in 0 : its.count()
            none.add(0)
        .addColoredOption(its, none)

    # An option whose items carry colors (0 = none). Only a SECONDARY item may be colored.
    def addColoredOption(its: List(int), cols: List(int))
        require
            its.count() >= 1
            cols.count() == its.count()
        var p: int = .last_spacer
        var k: int = its.count()
        for j in 1 : k + 1
            var it: int = its[j - 1]
            assert it >= 1 and it <= .items
            var q: int = .ulink[it]
            assert cols[j - 1] == 0 or it > .primary, "only a secondary item can carry a color"
            .top.add(it)                    # node p+j
            .ulink.add(q)
            .dlink.add(it)
            .color.add(cols[j - 1])
            .dlink[q] = p + j
            .ulink[it] = p + j
            .top[it] += 1                   # LEN(it)
        .options += 1
        .dlink[p] = p + k
        .top.add(0 - .options)              # the next spacer, node p+k+1
        .ulink.add(p + 1)
        .dlink.add(0)
        .color.add(0)
        .last_spacer = p + k + 1

    def hide(p: int)
        var q: int = p + 1
        while q != p
            var x: int = .top[q]
            var u: int = .ulink[q]
            var d: int = .dlink[q]
            if x <= 0
                q = u                       # a spacer: back to the option's first node
            else if .color[q] < 0
                q += 1                      # purified: already out of play (hide')
            else
                .dlink[u] = d
                .ulink[d] = u
                .top[x] -= 1
                q += 1

    def unhide(p: int)
        var q: int = p - 1
        while q != p
            var x: int = .top[q]
            var u: int = .ulink[q]
            var d: int = .dlink[q]
            if x <= 0
                q = d                       # a spacer: on to the option's last node
            else if .color[q] < 0
                q -= 1                      # purified (unhide')
            else
                .dlink[u] = q
                .ulink[d] = q
                .top[x] += 1
                q -= 1

    def cover(i: int)
        var p: int = .dlink[i]
        while p != i
            .hide(p)
            p = .dlink[p]
        var l: int = .llink[i]
        var r: int = .rlink[i]
        .rlink[l] = r
        .llink[r] = l

    def uncover(i: int)
        var l: int = .llink[i]
        var r: int = .rlink[i]
        .rlink[l] = i
        .llink[r] = i
        var p: int = .ulink[i]
        while p != i
            .unhide(p)
            p = .ulink[p]

    # Algorithm C: choosing an option that gives secondary item j color c keeps every other
    # option that gives j the same color, and hides the rest (purify); an uncolored use
    # covers j outright. commit/uncommit pick between them.
    def purify(p: int)
        var c: int = .color[p]
        var it: int = .top[p]
        var q: int = .dlink[it]
        while q != it
            if .color[q] == c
                .color[q] = -1
            else
                .hide(q)
            q = .dlink[q]

    def unpurify(p: int)
        var c: int = .color[p]
        var it: int = .top[p]
        var q: int = .ulink[it]
        while q != it
            if .color[q] < 0
                .color[q] = c
            else
                .unhide(q)
            q = .ulink[q]

    def commit(p: int, j: int)
        if .color[p] == 0
            .cover(j)
        else if .color[p] > 0
            .purify(p)

    def uncommit(p: int, j: int)
        if .color[p] == 0
            .uncover(j)
        else if .color[p] > 0
            .unpurify(p)

    # The 0-based number of the option node x belongs to: walk right to its spacer.
    def optionOf(x: int): int
        var q: int = x
        while .top[q] > 0
            q += 1
        return 0 - .top[q] - 1

    # Every solution, each as the sorted 0-based numbers of its options; `limit` stops early
    # (0 = all). Knuth's steps X2..X8 as a state machine on the step number (X1, the
    # initialisation, is init + addOption).
    def solutions(limit: int): List(List(int))
        require
            limit >= 0
        var found: List(List(int)) = List(List(int))()
        var x = List(int)()                 # x_0 .. x_{l-1}
        var l: int = 0
        var i: int = 0
        var step: int = 2
        while true
            if step == 2                    # X2. [Enter level l.]
                if .rlink[0] == 0
                    var sol = List(int)()
                    for k in 0 : l
                        sol.add(.optionOf(x[k]))
                    sol.sort()
                    found.add(sol)
                    if limit > 0 and found.count() >= limit
                        break
                    step = 8
                else
                    step = 3
            else if step == 3               # X3. [Choose i.] -- fewest live options (MRV)
                i = .rlink[0]
                var theta: int = .top[i]
                var c: int = .rlink[i]
                while c != 0
                    if .top[c] < theta
                        theta = .top[c]
                        i = c
                    c = .rlink[c]
                .cover(i)                   # X4. [Cover i.]
                if x.count() <= l
                    x.add(.dlink[i])
                else
                    x[l] = .dlink[i]
                step = 5
            else if step == 5               # X5. [Try x_l.]
                if x[l] == i
                    step = 7
                else
                    var p: int = x[l] + 1
                    while p != x[l]
                        var j: int = .top[p]
                        if j <= 0
                            p = .ulink[p]
                        else
                            .commit(p, j)
                            p += 1
                    l += 1
                    step = 2
            else if step == 6               # X6. [Try again.]
                var p6: int = x[l] - 1
                while p6 != x[l]
                    var j6: int = .top[p6]
                    if j6 <= 0
                        p6 = .dlink[p6]
                    else
                        .uncommit(p6, j6)
                        p6 -= 1
                i = .top[x[l]]
                x[l] = .dlink[x[l]]
                step = 5
            else if step == 7               # X7. [Backtrack.]
                .uncover(i)
                step = 8
            else                            # X8. [Leave level l.]
                if l == 0
                    break
                l -= 1
                step = 6
        return found

# n queens as exact cover (§7.2.2.1): rows and columns PRIMARY, the two diagonal families
# SECONDARY -- a diagonal may be empty, but never doubly occupied.
def queens(n: int): ExactCover
    require
        n >= 1
    var diag: int = 2 * n - 1
    var ec = ExactCover(2 * n, 2 * diag)
    for r in 0 : n
        for c in 0 : n
            ec.addOption([1 + r, 1 + n + c, 1 + 2 * n + (r + c), 1 + 2 * n + diag + (r - c + n - 1)])
    return ec

# ── Vol. 2 §3.3.4: Algorithm S, the spectral test ─────────────────────────────────────────
#
# For the linear congruential sequence X_{n+1} = (a X_n + c) mod m, nu_t is the length of the
# shortest nonzero vector (s_1, ..., s_t) with s_1 + s_2 a + ... + s_t a^(t-1) = 0 (mod m):
# 1/nu_t is the distance between the parallel hyperplanes covering the points
# (X_n, ..., X_{n+t-1}). A good multiplier has every nu_t large. These return nu_t SQUARED,
# exactly, for t = 2 .. tmax. 128-bit arithmetic throughout: with m near 2^31 the dot products
# in steps S5-S7 pass 2^62.

# floor(n / d) for d > 0 (integer `/` truncates toward zero).
def floorDiv128(n: int128, d: int128): int128
    require
        d > 0
    var q: int128 = n / d
    if n % d != 0 and n < 0
        q -= 1
    return q

# Knuth's round(x) = floor(x + 1/2), of the rational n / d, d > 0.
def roundDiv128(n: int128, d: int128): int128
    require
        d > 0
    return floorDiv128(2 * n + d, 2 * d)

# floor(sqrt(n)), by Newton's method on integers.
def isqrt128(n: int128): int128
    require
        n >= 0
    ensure
        result * result <= n
        (result + 1) * (result + 1) > n
    if n < 2
        return n
    var x: int128 = n
    var y: int128 = (x + n / x) / 2
    while y < x
        x = y
        y = (x + n / x) / 2
    return x

def dot128(x: List(int128), y: List(int128)): int128
    var sum: int128 = 0
    for i in 0 : x.count()
        sum += x[i] * y[i]
    return sum

def spectralTest(a: int, m: int, tmax: int): List(int128)
    require
        m > 1
        a > 0
        a < m
        tmax >= 2
        tmax <= 8
    ensure
        result.count() == tmax - 1
    var out = List(int128)()
    var mm: int128 = m
    var aa: int128 = a
    var h: int128 = a                       # S1. [Initialize.]
    var hp: int128 = m
    var p: int128 = 1
    var pp: int128 = 0
    var r: int128 = a
    var s: int128 = 1 + h * h
    var u: int128 = 0
    var v: int128 = 0
    while true                              # S2. [Euclidean step.]
        var q: int128 = hp / h
        u = hp - q * h
        v = pp - q * p
        if u * u + v * v < s
            s = u * u + v * v
            hp = h
            h = u
            pp = p
            p = v
            if h == 0
                break
        else
            break
    u = u - h                               # S3. [Compute nu_2.]
    v = v - p
    if u * u + v * v < s
        s = u * u + v * v
        hp = u
        pp = v
    out.add(s)
    var U: List(List(int128)) = List(List(int128))()
    var V: List(List(int128)) = List(List(int128))()
    U.add([0 - h, p])
    U.add([0 - hp, pp])
    # V = +-(p' h'; -p -h). The sign is the one that makes U V^T = m I -- Knuth's invariant,
    # asserted below after every transformation -- so it is DERIVED from U_1 . V_1 rather
    # than remembered: getting it backwards leaves nu_2 right (S3 computes it directly) and
    # every later nu_t too large, which is how this was found.
    var sg: int128 = 1
    if p * hp - h * pp < 0
        sg = -1
    V.add([sg * pp, sg * hp])
    V.add([0 - sg * p, 0 - sg * h])
    var t: int = 2
    while t < tmax                          # S4. [Advance t.]
        t += 1
        r = (aa * r) % mm
        for i in 0 : t - 1
            U[i].add(0)
            V[i].add(0)
        var ut = List(int128)()
        var vt = List(int128)()
        for i in 0 : t
            ut.add(0)
            vt.add(0)
        ut[0] = 0 - r
        ut[t - 1] = 1
        vt[t - 1] = mm
        for i in 0 : t - 1
            var q4: int128 = roundDiv128(V[i][0] * r, mm)
            # V_i's new coordinate is v_i1 r, reduced by q m: the V rows generate the
            # lattice spanned by (1, a, ..., a^(t-1)) and m e_j, so a row whose first
            # coordinate is v_i1 needs v_i1 r (mod m) in the new place. (Extending with 0
            # leaves U_t . V_i = -r v_i1, and the invariant check below fails at once.)
            V[i][t - 1] = V[i][0] * r - q4 * mm
            for c in 0 : t
                ut[c] = ut[c] + q4 * U[i][c]
        U.add(ut)
        V.add(vt)
        var uu: int128 = dot128(ut, ut)
        if uu < s
            s = uu
        var k: int = t - 1
        var j: int = 0
        while true
            for i in 0 : t                  # S5. [Transform.]
                if i != j
                    var vij: int128 = dot128(V[i], V[j])
                    var vjj: int128 = dot128(V[j], V[j])
                    var avij: int128 = vij
                    if avij < 0
                        avij = 0 - avij
                    if 2 * avij > vjj
                        var q5: int128 = roundDiv128(vij, vjj)
                        for c in 0 : t
                            V[i][c] = V[i][c] - q5 * V[j][c]
                            U[j][c] = U[j][c] + q5 * U[i][c]
                        k = j
            if j == t - 1                   # S6. [Advance j.]
                j = 0
            else
                j += 1
            if j == k
                break
        for i in 0 : t                      # the invariant: U_i . V_j = m [i = j]
            for jj in 0 : t
                var want: int128 = 0
                if i == jj
                    want = mm
                assert dot128(U[i], V[jj]) == want, "spectral test: U V^T != m I"
        var X = List(int128)()              # S7. [Prepare for search.]
        var Y = List(int128)()
        var z = List(int128)()
        for i in 0 : t
            X.add(0)
            Y.add(0)
            z.add(isqrt128((dot128(V[i], V[i]) * s) / (mm * mm)))
        var kk: int = t - 1                 # 0-based k
        var step: int = 8
        while true
            if step == 8                    # S8. [Advance X_k.]
                if X[kk] == z[kk]
                    step = 10
                else
                    X[kk] += 1
                    for c in 0 : t
                        Y[c] = Y[c] + U[kk][c]
                    step = 9
            else if step == 9               # S9. [Advance k.]
                kk += 1
                while kk <= t - 1
                    X[kk] = 0 - z[kk]
                    for c in 0 : t
                        Y[c] = Y[c] - 2 * z[kk] * U[kk][c]
                    kk += 1
                var yy: int128 = dot128(Y, Y)
                if yy < s
                    s = yy
                step = 10
            else                            # S10. [Decrease k.]
                kk -= 1
                if kk >= 0
                    step = 8
                else
                    break
        out.add(s)
    return out

# -- Vol. 4A 7.2.1.3: Algorithm L, lexicographic combinations --------------------------------
# Every t-combination of {0, ..., n-1}, each as its elements in increasing order, visited in
# Knuth's order: lexicographic in the DECREASING sequence c_t ... c_1 -- colex, which is also
# increasing order of the bitmask 2^c_1 + ... + 2^c_t.
def combinations(n: int, t: int): List(List(int))
    require
        n >= t
        t >= 1
    var out: List(List(int)) = List(List(int))()
    var c = List(int)()                      # c_1 .. c_t, then the sentinels c_{t+1}, c_{t+2}
    for j in 1 : t + 1                       # L1. [Initialize.]
        c.add(j - 1)
    c.add(n)
    c.add(0)
    while true
        var comb = List(int)()               # L2. [Visit.]
        for j in 0 : t
            comb.add(c[j])
        out.add(comb)
        var j: int = 0                       # L3. [Find j.] (0-based: c[0] is c_1)
        while c[j] + 1 == c[j + 1]
            c[j] = j
            j += 1
        if j >= t                            # L4. [Done?]
            break
        c[j] += 1                            # L5. [Increase c_j.]
    return out

# -- Vol. 2 4.3.1: Algorithm D, division of nonnegative integers -------------------------------
# Digits are base b, LEAST significant first. u has m + n digits, v has n >= 2 digits with a
# nonzero leading digit; the result is [q (m + 1 digits), r (n digits), [add-backs]], where
# add-backs counts how often step D6 ran -- Knuth's rare correction, which a test has to see
# happen before it can claim the step works. b up to 2^16 keeps every product in an int.
def mpDivide(u: List(int), v: List(int), b: int): List(List(int))
    require
        v.count() >= 2
        v[v.count() - 1] != 0
        u.count() >= v.count()
        b >= 4
        b <= 65536
    var n: int = v.count()
    var m: int = u.count() - n
    var d: int = b / (v[n - 1] + 1)          # D1. [Normalize.]
    var un = List(int)()
    var carry: int = 0
    for i in 0 : m + n
        var pu: int = u[i] * d + carry
        un.add(pu % b)
        carry = pu / b
    un.add(carry)
    var vn = List(int)()
    carry = 0
    for i in 0 : n
        var pv: int = v[i] * d + carry
        vn.add(pv % b)
        carry = pv / b
    assert carry == 0, "normalising v must not add a digit"
    var q = List(int)()
    for i in 0 : m + 1
        q.add(0)
    var addbacks: int = 0
    var j: int = m                           # D2. [Initialize j.]
    while j >= 0
        var num: int = un[j + n] * b + un[j + n - 1]    # D3. [Calculate q-hat.]
        var qhat: int = num / vn[n - 1]
        var rhat: int = num % vn[n - 1]
        while rhat < b and (qhat == b or qhat * vn[n - 2] > b * rhat + un[j + n - 2])
            qhat -= 1
            rhat += vn[n - 1]
        var borrow: int = 0                  # D4. [Multiply and subtract.]
        carry = 0
        for i in 0 : n
            var p: int = qhat * vn[i] + carry
            carry = p / b
            var sub: int = un[i + j] - p % b - borrow
            if sub < 0
                un[i + j] = sub + b
                borrow = 1
            else
                un[i + j] = sub
                borrow = 0
        var top: int = un[j + n] - carry - borrow
        var negative: bool = top < 0
        if negative
            top += b
        un[j + n] = top
        q[j] = qhat                          # D5. [Test remainder.]
        if negative                          # D6. [Add back.]
            q[j] -= 1
            addbacks += 1
            carry = 0
            for i in 0 : n
                var s: int = un[i + j] + vn[i] + carry
                un[i + j] = s % b
                carry = s / b
            un[j + n] = (un[j + n] + carry) % b
        j -= 1                               # D7. [Loop on j.]
    var r = List(int)()                      # D8. [Unnormalize.] r = (u_{n-1} .. u_0) / d
    for i in 0 : n
        r.add(0)
    var rem: int = 0
    var k: int = n - 1
    while k >= 0
        var cur: int = rem * b + un[k]
        r[k] = cur / d
        rem = cur % d
        k -= 1
    assert rem == 0, "the normalised remainder is a multiple of d"
    return [q, r, [addbacks]]

# -- Vol. 2 3.2.1.1 / 3.6: the "minimal standard" generator, by Schrage's method --------------
# X_{n+1} = 16807 X_n mod (2^31 - 1), Lehmer's multiplicative generator as Park and Miller
# proposed it. Schrage's method (Knuth, 3.2.1.1, the approximate factorisation m = a q + r with
# r < q): a x mod m = a (x mod q) - r floor(x / q), plus m if that is negative -- every
# intermediate stays below m, so the step needs no double-width product. Knuth discusses the
# multiplier in 3.6 (and recommends 48271 over 16807).
const MINSTD_M = 2147483647              # 2^31 - 1, prime
const MINSTD_A = 16807                   # 7^5
const MINSTD_Q = 127773                  # m div a
const MINSTD_R = 2836                    # m mod a; r < q, which is what makes the method exact

def minstdNext(x: int): int
    require
        x > 0
        x < MINSTD_M
    ensure
        result > 0
        result < MINSTD_M
    var t: int = MINSTD_A * (x % MINSTD_Q) - MINSTD_R * (x / MINSTD_Q)
    if t < 0
        t += MINSTD_M
    return t

# -- Vol. 2 4.5.4: Algorithm P, the strong probable-prime test (Miller-Rabin) ----------------
# For odd n > 2 write n - 1 = 2^k q with q odd. n passes for the base x if x^q = 1, or
# x^(2^j q) = -1 for some 0 <= j < k (mod n); a prime passes for every base, and an odd
# composite for at most a quarter of them. Knuth's test draws x at random; here the bases are
# given, which makes the answer deterministic and lets a test choose bases that FAIL to catch
# a composite on purpose. 128-bit arithmetic: n may be close to 2^63, so a product of two
# residues needs 126 bits.
def mulMod128(a: int128, b: int128, m: int128): int128
    require
        m > 0
    return (a * b) % m

def powMod128(x: int128, e: int128, m: int128): int128
    require
        e >= 0
        m >= 1
    var y: int128 = 1 % m                   # Algorithm A of 4.6.3, as powMod above
    var z: int128 = ((x % m) + m) % m
    var nn: int128 = e
    while nn > 0
        if nn % 2 == 1
            y = mulMod128(y, z, m)
        nn = nn / 2
        if nn > 0
            z = mulMod128(z, z, m)
    return y

# One base x, 1 < x < n - 1: true if n is a strong probable prime to base x.
def strongProbablePrime(n: int128, x: int128): bool
    require
        n > 3
        n % 2 == 1
        x > 1
        x < n - 1
    var q: int128 = n - 1
    var k: int = 0
    while q % 2 == 0
        q = q / 2
        k += 1
    var j: int = 0                          # P2. [Power x.]
    var y: int128 = powMod128(x, q, n)
    while true
        if (j == 0 and y == 1) or y == n - 1    # P3. [Done?]
            return true
        if j > 0 and y == 1
            return false                    # P5: 1 reached without passing through -1
        j += 1                              # P4. [Increase j.]
        if j >= k
            return false                    # P5. [Not prime.]
        y = mulMod128(y, y, n)

# n prime or a strong probable prime to every listed base. A base that is 0, 1 or -1 mod n
# says nothing and is skipped.
def isProbablePrime(n: int, bases: List(int)): bool
    if n < 2
        return false
    if n < 4
        return true
    if n % 2 == 0
        return false
    var nn: int128 = n
    for b in bases
        var x: int128 = b
        x = x % nn
        if x > 1 and x < nn - 1
            if not strongProbablePrime(nn, x)
                return false
    return true

# -- Vol. 4A 7.2.1.4: Algorithm P, partitions of n in reverse lexicographic order ------------
# Each partition as its parts a_1 >= a_2 >= ... >= a_m. a_0 = 0 is Knuth's sentinel: step P5
# reaches q = 0 only after the last partition, 1 + 1 + ... + 1.
def partitions(n: int): List(List(int))
    require
        n >= 1
    var out: List(List(int)) = List(List(int))()
    var a = List(int)()
    for i in 0 : n + 2
        a.add(0)
    var rest: int = n                       # Knuth's n, reused for what is left to place
    var m: int = 1                          # P1. [Initialize.] (a_0 = 0 already)
    var q: int = 0
    var x: int = 0
    var step: int = 2
    while true
        if step == 2                        # P2. [Store final part.]
            a[m] = rest
            q = m
            if rest == 1
                q -= 1
            step = 3
        else if step == 3                   # P3. [Visit.]
            var part = List(int)()
            for i in 1 : m + 1
                part.add(a[i])
            out.add(part)
            if a[q] == 2
                step = 4
            else
                step = 5
        else if step == 4                   # P4. [Change 2 to 1 + 1.]
            a[q] = 1
            q -= 1
            m += 1
            a[m] = 1
            step = 3
        else if step == 5                   # P5. [Decrease a_q.]
            if q == 0
                break
            x = a[q] - 1
            a[q] = x
            rest = m - q + 1
            m = q + 1
            step = 6
        else                                # P6. [Copy x if necessary.]
            if rest <= x
                step = 2
            else
                a[m] = x
                m += 1
                rest -= x
    return out

# -- Vol. 4A 7.2.1.5: Algorithm H, set partitions as restricted growth strings --------------
# A partition of {1..n} into blocks is the string a_1 ... a_n with a_1 = 0 and
# a_j <= 1 + max(a_1, ..., a_{j-1}) -- element j goes in block a_j. Visited in lexicographic
# order. b_j = 1 + max(a_1, ..., a_{j-1}), and m = b_n.
def setPartitions(n: int): List(List(int))
    require
        n >= 1
    var out: List(List(int)) = List(List(int))()
    if n == 1
        out.add([0])
        return out
    var a = List(int)()                     # a_1 .. a_n at a[1] .. a[n]
    var b = List(int)()                     # b_1 .. b_{n-1} at b[1] .. b[n-1]
    for i in 0 : n + 1                      # H1. [Initialize.]
        a.add(0)
        b.add(1)
    var m: int = 1
    var j: int = 0
    var step: int = 2
    while true
        if step == 2                        # H2. [Visit.]
            var rgs = List(int)()
            for i in 1 : n + 1
                rgs.add(a[i])
            out.add(rgs)
            if a[n] == m
                step = 4
            else
                step = 3
        else if step == 3                   # H3. [Increase a_n.]
            a[n] += 1
            step = 2
        else if step == 4                   # H4. [Find j.] (a_1 = 0 < b_1 = 1 stops it)
            j = n - 1
            while a[j] == b[j]
                j -= 1
            step = 5
        else if step == 5                   # H5. [Increase a_j.]
            if j == 1
                break
            a[j] += 1
            step = 6
        else                                # H6. [Zero out a_{j+1} .. a_n.]
            m = b[j]
            if a[j] == b[j]
                m += 1
            j += 1
            while j < n
                a[j] = 0
                b[j] = m
                j += 1
            a[n] = 0
            step = 2
    return out

# -- Vol. 4A 7.2.1.6: Algorithm P, nested parentheses -------------------------------------
# Every string of n pairs of balanced parentheses, as 0 = '(' and 1 = ')', visited from
# ()()...() to ((...)): each visit is lexicographically SMALLER than the one before when
# '(' < ')' (measured by the test: 23703 steps, every one downward, n = 1..10). a_0 = ')' is Knuth's sentinel, and at
# step P2 a_m = '(' with every a_k = ')' for m < k <= 2n -- so step P5 resets m to 2n - 1,
# where step P4 put the last left parenthesis.
const PAREN_L = 0
const PAREN_R = 1

def nestedParentheses(n: int): List(List(int))
    require
        n >= 1
    var out: List(List(int)) = List(List(int))()
    # Knuth's Algorithm P assumes n >= 2: with one pair, step P3's easy-case test reads the
    # sentinel a_0 = ')' as a right parenthesis and steps off the front of the array (the
    # test found this; the n = 2 hand trace could not). One pair has one string.
    if n == 1
        out.add([PAREN_L, PAREN_R])
        return out
    var a = List(int)()
    a.add(PAREN_R)                          # a_0, the sentinel
    for k in 1 : n + 1                      # P1. [Initialize.] ()()...()
        a.add(PAREN_L)
        a.add(PAREN_R)
    var m: int = 2 * n - 1
    while true
        var s = List(int)()                 # P2. [Visit.]
        for i in 1 : 2 * n + 1
            s.add(a[i])
        out.add(s)
        a[m] = PAREN_R                      # P3. [Easy case?]
        if a[m - 1] == PAREN_R
            a[m - 1] = PAREN_L
            m -= 1
            continue
        var j: int = m - 1                  # P4. [Find j.]
        var k: int = 2 * n - 1
        while a[j] == PAREN_L
            a[j] = PAREN_R
            a[k] = PAREN_L
            j -= 1
            k -= 2
        if j == 0                           # P5. [Increase a_j.]
            break
        a[j] = PAREN_L
        m = 2 * n - 1
    return out

# -- Vol. 4B 7.2.2.1: Langford pairs as exact cover ---------------------------------------
# Place two copies of each of 1..n in 2n slots so the copies of k have exactly k numbers
# between them. Items 1..n are the values, n+1..3n the slots; the option for value v at
# slot i (1-based) is {v, slot i, slot i + v + 1}. Every arrangement and its reversal are
# both found (no Langford sequence is its own reversal), so the count is twice OEIS A014552.
def langford(n: int): ExactCover
    require
        n >= 1
    var ec = ExactCover(3 * n, 0)
    for v in 1 : n + 1
        for i in 1 : 2 * n - v
            ec.addOption([v, n + i, n + i + v + 1])
    return ec

# -- Vol. 4B 7.2.2.1: the twelve pentominoes in a 6 x 10 box, as exact cover -------------
# Items 1..12 are the pieces (F I L N P T U V W X Y Z), 13..72 the cells. Each piece in each
# of its distinct orientations at each position in the box is one option. The X pentomino is
# symmetric under all eight motions, so restricting its centre to the top-left quarter of the
# box (rows 0-2, columns 0-4: the box has no centre row or column) counts each solution
# exactly once up to the box's four symmetries.
def pentominoShapes(): List(List(int))
    # each shape as row, col, row, col, ... (five cells)
    return [[0, 1, 0, 2, 1, 0, 1, 1, 2, 1],          # F
        [0, 0, 1, 0, 2, 0, 3, 0, 4, 0],              # I
        [0, 0, 1, 0, 2, 0, 3, 0, 3, 1],              # L
        [0, 0, 1, 0, 1, 1, 2, 1, 3, 1],              # N
        [0, 0, 0, 1, 1, 0, 1, 1, 2, 0],              # P
        [0, 0, 0, 1, 0, 2, 1, 1, 2, 1],              # T
        [0, 0, 0, 2, 1, 0, 1, 1, 1, 2],              # U
        [0, 0, 1, 0, 2, 0, 2, 1, 2, 2],              # V
        [0, 0, 1, 0, 1, 1, 2, 1, 2, 2],              # W
        [0, 1, 1, 0, 1, 1, 1, 2, 2, 1],              # X
        [0, 0, 1, 0, 2, 0, 3, 0, 1, 1],              # Y
        [0, 0, 0, 1, 1, 1, 2, 1, 2, 2]]              # Z

# A shape moved so its smallest row and column are 0, cells sorted: the canonical form two
# orientations must share to be the same orientation.
def normalizeCells(cells: List(int)): List(int)
    var minr: int = cells[0]
    var minc: int = cells[1]
    for i in 0 : cells.count() / 2
        if cells[2 * i] < minr
            minr = cells[2 * i]
        if cells[2 * i + 1] < minc
            minc = cells[2 * i + 1]
    var keys = List(int)()                  # row * 16 + col, sorted
    for i in 0 : cells.count() / 2
        keys.add((cells[2 * i] - minr) * 16 + (cells[2 * i + 1] - minc))
    keys.sort()
    var out = List(int)()
    for kk in keys
        out.add(kk / 16)
        out.add(kk % 16)
    return out

# The distinct orientations of a shape under the eight motions of the square.
def orientations(cells: List(int)): List(List(int))
    var out: List(List(int)) = List(List(int))()
    for t in 0 : 8
        var img = List(int)()
        for i in 0 : cells.count() / 2
            var r: int = cells[2 * i]
            var c: int = cells[2 * i + 1]
            var rr: int = r
            var cc: int = c
            if t == 1
                rr = c
                cc = 0 - r
            else if t == 2
                rr = 0 - r
                cc = 0 - c
            else if t == 3
                rr = 0 - c
                cc = r
            else if t == 4
                rr = r
                cc = 0 - c
            else if t == 5
                rr = 0 - r
                cc = c
            else if t == 6
                rr = c
                cc = r
            else if t == 7
                rr = 0 - c
                cc = 0 - r
            img.add(rr)
            img.add(cc)
        var norm = normalizeCells(img)
        var seen: bool = false
        for o in out
            if o == norm
                seen = true
        if not seen
            out.add(norm)
    return out

def pentominoBox(rows: int, cols: int, quarterX: bool): ExactCover
    require
        rows * cols == 60
    var shapes = pentominoShapes()
    var ec = ExactCover(12 + rows * cols, 0)
    for p in 0 : 12
        for o in orientations(shapes[p])
            var h: int = 0
            var w: int = 0
            for i in 0 : 5
                if o[2 * i] > h
                    h = o[2 * i]
                if o[2 * i + 1] > w
                    w = o[2 * i + 1]
            for dr in 0 : rows - h
                for dc in 0 : cols - w
                    if quarterX and p == 9      # X: its centre is cell (1, 1) of the shape
                        if dr + 1 > (rows - 1) / 2 or dc + 1 > (cols - 1) / 2
                            continue
                    var its = List(int)()
                    its.add(p + 1)
                    for i in 0 : 5
                        its.add(13 + (o[2 * i] + dr) * cols + (o[2 * i + 1] + dc))
                    ec.addOption(its)
    return ec

# -- Vol. 1 2.2.3: Algorithm T, topological sorting ---------------------------------------
# Objects 1..n and relations j < k ("j precedes k"), given as pairs. The output lists the
# objects so that j comes before k for every relation; if the relations contain a loop, the
# output is SHORTER than n (Knuth's step T8: N > 0 at the end). COUNT[k] counts the
# unfinished predecessors of k; TOP[j] heads the list of j's successors (SUC, NEXT); the
# queue of objects with COUNT zero is linked through QLINK.
def topologicalSort(n: int, pairs: List(int)): List(int)
    require
        n >= 1
        pairs.count() % 2 == 0
    var count = List(int)()
    var top = List(int)()
    var qlink = List(int)()
    for k in 0 : n + 1                      # T1. [Initialize.]
        count.add(0)
        top.add(-1)
        qlink.add(0)
    var suc = List(int)()
    var nxt = List(int)()
    for r in 0 : pairs.count() / 2          # T2/T3. [Next relation.] [Record the relation.]
        var j: int = pairs[2 * r]
        var k: int = pairs[2 * r + 1]
        assert j >= 1 and j <= n and k >= 1 and k <= n
        count[k] += 1
        suc.add(k)
        nxt.add(top[j])
        top[j] = suc.count() - 1
    var rr: int = 0                         # T4. [Scan for zeros.]
    for k in 1 : n + 1
        if count[k] == 0
            qlink[rr] = k
            rr = k
    var f: int = qlink[0]
    var out = List(int)()
    while f != 0                            # T5. [Output front of queue.]
        out.add(f)
        var p: int = top[f]
        while p >= 0                        # T6. [Erase relations.]
            var s: int = suc[p]
            count[s] -= 1
            if count[s] == 0
                qlink[rr] = s
                rr = s
            p = nxt[p]
        f = qlink[f]                        # T7. [Remove from queue.]
    return out                              # T8. [End of process.]

# -- Vol. 3 6.2.3: Algorithm A, balanced tree search and insertion (AVL) ------------------
# Knuth's layout: node 0 is HEAD, whose RLINK is the root and whose LLINK holds the height of
# the tree; -1 is LAMBDA. B(P) is the balance factor, height(right) - height(left), always
# -1, 0 or +1. LINK(a, P) for a = -1 / +1 is LLINK / RLINK, which lets steps A6-A10 handle
# the two mirror-image cases with one piece of code. S is the node where rebalancing may be
# necessary (the last node on the search path with a nonzero balance factor), T its parent.
class AvlTree
    var key: List(int)
    var llink: List(int)
    var rlink: List(int)
    var bal: List(int)
    var size: int

    cue init()
        .key = [0]                          # HEAD
        .llink = [0]                        # LLINK(HEAD): the height
        .rlink = [-1]                       # RLINK(HEAD): the root
        .bal = [0]
        .size = 0

    def link(a: int, p: int): int
        if a < 0
            return .llink[p]
        return .rlink[p]

    def setLink(a: int, p: int, v: int)
        if a < 0
            .llink[p] = v
        else
            .rlink[p] = v

    def newNode(k: int): int
        .key.add(k)                         # A5. [Insert.]
        .llink.add(-1)
        .rlink.add(-1)
        .bal.add(0)
        .size += 1
        return .key.count() - 1

    def height(): int
        return .llink[0]

    # Insert k; false if it was already present.
    def insert(k: int): bool
        if .rlink[0] < 0                    # an empty tree: the root is the new node
            .rlink[0] = .newNode(k)
            .llink[0] = 1
            return true
        var t: int = 0                      # A1. [Initialize.]
        var s: int = .rlink[0]
        var p: int = s
        var q: int = -1
        while true                          # A2. [Compare.]
            if k == .key[p]
                return false
            var dir: int = if(k < .key[p], -1, 1)
            q = .link(dir, p)               # A3 / A4. [Move left / right.]
            if q < 0
                q = .newNode(k)
                .setLink(dir, p, q)
                break
            if .bal[q] != 0
                t = p
                s = q
            p = q
        var a: int = if(k < .key[s], -1, 1) # A6. [Adjust balance factors.]
        var r: int = .link(a, s)
        p = r
        while p != q
            if k < .key[p]
                .bal[p] = -1
                p = .llink[p]
            else
                .bal[p] = 1
                p = .rlink[p]
        if .bal[s] == 0                     # A7. [Balancing act.] (i) the tree got higher
            .bal[s] = a
            .llink[0] += 1
            return true
        if .bal[s] == 0 - a                 # (ii) the tree got more balanced
            .bal[s] = 0
            return true
        if .bal[r] == a                     # (iii) out of balance: A8, single rotation
            p = r
            .setLink(a, s, .link(0 - a, r))
            .setLink(0 - a, r, s)
            .bal[s] = 0
            .bal[r] = 0
        else                                # A9. [Double rotation.]
            p = .link(0 - a, r)
            .setLink(0 - a, r, .link(a, p))
            .setLink(a, p, r)
            .setLink(a, s, .link(0 - a, p))
            .setLink(0 - a, p, s)
            if .bal[p] == a
                .bal[s] = 0 - a
                .bal[r] = 0
            else if .bal[p] == 0
                .bal[s] = 0
                .bal[r] = 0
            else
                .bal[s] = 0
                .bal[r] = a
            .bal[p] = 0
        if s == .rlink[t]                   # A10. [Finishing touch.]
            .rlink[t] = p
        else
            .llink[t] = p
        return true

    def contains(k: int): bool
        var p: int = .rlink[0]
        while p >= 0
            if k == .key[p]
                return true
            p = if(k < .key[p], .llink[p], .rlink[p])
        return false

    # The keys in symmetric (in-) order, iteratively with an explicit stack (Algorithm T of
    # 2.3.1).
    def inorder(): List(int)
        var out = List(int)()
        var stack = List(int)()
        var p: int = .rlink[0]
        while true
            if p >= 0                       # T3. [Stack <= P.]
                stack.add(p)
                p = .llink[p]
            else if stack.count() > 0       # T4. [P <= Stack.]
                p = stack.pop() catch -1
                out.add(.key[p])            # T5. [Visit P.]
                p = .rlink[p]
            else
                break
        return out

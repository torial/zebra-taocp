# Every expected value below comes from OUTSIDE this repository: Knuth's published test
# output, the book's worked examples, or a closed-form count. None was recorded from a run.
use taocp exposing RanArray, gcd, binaryGcd, powMod, heapSort, quickSort, quickSortM, insertionSort, isSorted, binarySearch, nextPermutation, grayCodes, ExactCover, queens, spectralTest, isqrt128, floorDiv128, combinations, mpDivide

def countPermutations(start: List(int)): int
    var a = start.copy()
    var count: int = 1
    while nextPermutation(a)
        count += 1
    return count

# The spectral test's oracle: the shortest nonzero (s_1..s_t) with
# s_1 + s_2 a + ... + s_t a^(t-1) = 0 (mod m), by exhaustive search over |s_i| <= sqrt(bound)
# for i >= 2, s_1 taken as the centred residue (the shortest choice). Using Algorithm S's own
# answer as `bound` is sound both ways: too large, and the true shorter vector is inside the
# box; too small, and the search finds nothing that short and answers -1. A box over
# 250,000 points is not searched: -2, "too large to check", reported as such -- never as
# agreement.
def bruteNu2(a: int, m: int, t: int, bound: int128): int128
    var mm: int128 = m
    var aa: int128 = a
    var B: int128 = isqrt128(bound)
    var points: int128 = 1
    for i in 0 : t - 1
        points = points * (2 * B + 1)
    if points > 250000
        return -2
    var pw = List(int128)()                  # a^(i-1) mod m
    var pv: int128 = 1
    for i in 0 : t
        pw.add(pv)
        pv = (pv * aa) % mm
    var d = List(int128)()                   # s_2 .. s_t, an odometer over [-B, B]
    for i in 0 : t - 1
        d.add(0 - B)
    var best: int128 = -1
    while true
        var sum: int128 = 0
        var sq: int128 = 0
        var allzero: bool = true
        for i in 0 : t - 1
            sum += d[i] * pw[i + 1]
            sq += d[i] * d[i]
            if d[i] != 0
                allzero = false
        if not allzero
            var c: int128 = floorDiv128(0 - sum, mm)
            c = (0 - sum) - c * mm                # (-sum) mod m, in [0, m)
            if 2 * c > mm
                c -= mm
            var len: int128 = c * c + sq
            if len <= bound and (best < 0 or len < best)
                best = len
        var pos: int = 0                     # advance the odometer
        while pos < t - 1 and d[pos] == B
            d[pos] = 0 - B
            pos += 1
        if pos == t - 1
            break
        d[pos] += 1
    return best

# Algorithm C's oracle: count the solutions of a colored exact-cover problem by trying every
# subset of options. Valid when every primary item is used exactly once, and every secondary
# item is either used once without a color or used only with one color.
def bruteColored(primary: int, items: int, opts: List(List(int)), cols: List(List(int))): int
    var nopt: int = opts.count()
    var count: int = 0
    for mask in 1 : (1 << nopt)
        var uses = List(int)()               # per item: occurrences
        var colr = List(int)()               # per item: the color seen (-1 none yet, 0 uncolored)
        var ok: bool = true
        for it in 0 : items + 1
            uses.add(0)
            colr.add(-1)
        for o in 0 : nopt
            if ((mask >> o) & 1) == 1
                for k in 0 : opts[o].count()
                    var it: int = opts[o][k]
                    var c: int = cols[o][k]
                    uses[it] += 1
                    if it <= primary
                        if uses[it] > 1
                            ok = false
                    else
                        if c == 0 and uses[it] > 1
                            ok = false
                        if colr[it] == 0 and uses[it] > 1
                            ok = false
                        if colr[it] > 0 and c != colr[it]
                            ok = false
                        colr[it] = c
        for it in 1 : primary + 1
            if uses[it] != 1
                ok = false
        if ok
            count += 1
    return count

# Algorithm D's oracles. Digits are base b, least significant first.
def mpValue(x: List(int), b: int): int128
    var bb: int128 = b
    var v: int128 = 0
    var k: int = x.count() - 1
    while k >= 0
        var dk: int128 = x[k]
        v = v * bb + dk
        k -= 1
    return v

# x * y by schoolbook multiplication (Vol. 2 4.3.1, Algorithm M).
def mpMul(x: List(int), y: List(int), b: int): List(int)
    var w = List(int)()
    for i in 0 : x.count() + y.count()
        w.add(0)
    for j in 0 : y.count()
        var carry: int = 0
        for i in 0 : x.count()
            var t: int = x[i] * y[j] + w[i + j] + carry
            w[i + j] = t % b
            carry = t / b
        w[j + x.count()] = carry
    return w

# x + y (Algorithm A), as many digits as the longer plus one.
def mpAdd(x: List(int), y: List(int), b: int): List(int)
    var n: int = x.count()
    if y.count() > n
        n = y.count()
    var w = List(int)()
    var carry: int = 0
    for i in 0 : n
        var s: int = carry
        if i < x.count()
            s += x[i]
        if i < y.count()
            s += y[i]
        w.add(s % b)
        carry = s / b
    w.add(carry)
    return w

# -1, 0, 1 as x <, =, > y, ignoring leading zeros.
def mpCompare(x: List(int), y: List(int)): int
    var n: int = x.count()
    if y.count() > n
        n = y.count()
    var k: int = n - 1
    while k >= 0
        var xk: int = 0
        var yk: int = 0
        if k < x.count()
            xk = x[k]
        if k < y.count()
            yk = y[k]
        if xk != yk
            if xk < yk
                return -1
            return 1
        k -= 1
    return 0

def main()
    # Vol. 2 §3.6, rng.c's own test (corrected 2019): ran_x[0] = 995235265, both ways.
    var a = List(int)()
    for i in 0 : 2009
        a.add(0)
    var g1 = RanArray(310952)
    for m in 0 : 2009
        g1.fill(a, 1009)
    var g2 = RanArray(310952)
    for m in 0 : 1009
        g2.fill(a, 2009)
    print("ran_array: ${g1.x[0]} ${g2.x[0]}")         # 995235265 995235265

    # Vol. 1 §1.1: Euclid on the book's example, m = 544, n = 119.
    print("gcd: ${gcd(544, 119)}")                      # 17

    # Vol. 3 §5.2: Knuth's sixteen standard keys for the sorting chapter.
    var keys = [503, 87, 512, 61, 908, 170, 897, 275, 653, 426, 154, 509, 612, 677, 765, 703]
    heapSort(keys)
    print("heapsort: ${keys}")    # [61, 87, 154, 170, 275, 426, 503, 509, 512, 612, 653, 677, 703, 765, 897, 908]

    # Vol. 3 §6.2.1 on the sorted keys: 653 is the 11th smallest; 400 is absent.
    print("binary search: ${binarySearch(keys, 653)} ${binarySearch(keys, 400)}")   # 10 -1

    # Vol. 4A §7.2.1.2: n! permutations; a multiset's count is the multinomial coefficient.
    print("permutations: ${countPermutations([1, 2, 3, 4])} ${countPermutations([1, 1, 2, 2])} ${countPermutations([1, 2, 2, 3, 3, 3])}")   # 24 6 60

    # Vol. 4B §7.2.2.1, Knuth's example (5): items a..g, six options, ONE solution --
    # options 0 ('c e'), 3 ('a d f') and 4 ('b g').
    var ex = ExactCover(7, 0)
    ex.addOption([3, 5])          # c e
    ex.addOption([1, 4, 7])       # a d g
    ex.addOption([2, 3, 6])       # b c f
    ex.addOption([1, 4, 6])       # a d f
    ex.addOption([2, 7])          # b g
    ex.addOption([4, 5, 7])       # d e g
    print("exact cover: ${ex.solutions(0)}")              # [[0, 3, 4]]

    # n queens, n = 1..8: OEIS A000170.
    var qs = List(int)()
    for n in 1 : 9
        qs.add(queens(n).solutions(0).count())
    print("queens: ${qs}")                                # [1, 0, 0, 2, 10, 4, 40, 92]

    # Vol. 2 §4.5.2: binary gcd must agree with Euclid on every pair -- two of Knuth's
    # algorithms checking each other. 3600 pairs.
    var disagree: int = 0
    for u in 1 : 61
        for v in 1 : 61
            if binaryGcd(u, v) != gcd(u, v)
                disagree += 1
    print("binary gcd vs Euclid: ${disagree} disagreements")    # 0

    # Vol. 2 §4.6.3 against Fermat's little theorem: a^(p-1) = 1 (mod p), p = 1000000007.
    var fermat: int = 0
    for b in 2 : 21
        if powMod(b, 1000000006, 1000000007) == 1
            fermat += 1
    print("fermat: ${fermat}/19, 2^10 mod 1000 = ${powMod(2, 10, 1000)}")   # 19/19, 24

    # Vol. 3 §5.2.2: quicksort (M = 9 and pure, M = 1) and insertion sort against heapsort,
    # on 1000 keys from the §3.6 generator -- and on Knuth's sixteen keys.
    var g = RanArray(314159)
    var base = List(int)()
    for i in 0 : 1000
        base.add(g.next() % 10000)
    var h = base.copy()
    heapSort(h)
    var q9 = base.copy()
    quickSort(q9)
    var q1 = base.copy()
    quickSortM(q1, 1)
    var ins = base.copy()
    insertionSort(ins)
    var knuth16 = [503, 87, 512, 61, 908, 170, 897, 275, 653, 426, 154, 509, 612, 677, 765, 703]
    quickSortM(knuth16, 1)
    print("sorts agree: ${q9 == h} ${q1 == h} ${ins == h} ${knuth16 == keys}")   # true true true true

    # Vol. 4A §7.2.1.1: Algorithm G against the closed form g(k) = k xor floor(k/2).
    var codes = grayCodes(10)
    var gray_bad: int = 0
    for k in 0 : codes.count()
        if codes[k] != (k ^ (k >> 1))
            gray_bad += 1
    print("gray: ${codes.count()} codes, ${gray_bad} differ from k^(k>>1)")    # 1024 codes, 0 differ

    # Vol. 2 §3.3.4, Algorithm S against exhaustive search, nu_2..nu_5 for 16 generators.
    var spec_checked: int = 0
    var spec_agree: int = 0
    var spec_toobig: int = 0
    for mod in [1009, 65537]
        for mult in [2, 3, 5, 17, 75, 101, 500, mod - 1]
            var nus = spectralTest(mult, mod, 5)
            for ti in 0 : nus.count()
                var bf: int128 = bruteNu2(mult, mod, ti + 2, nus[ti])
                if bf == -2
                    spec_toobig += 1
                else
                    spec_checked += 1
                    if bf == nus[ti]
                        spec_agree += 1
    print("spectral vs brute force: ${spec_agree}/${spec_checked} agree (${spec_toobig} too large to search)")
    # RANDU, a = 65539, m = 2^31: a^2 = 6a - 9 (mod m), so (9, -6, 1) lies in the dual lattice
    # and nu_3^2 = 9^2 + 6^2 + 1 = 118 -- every point of its "random" triples sits on one of
    # only 15 planes (Marsaglia). Algorithm S must find exactly that, and nothing shorter.
    var randu = spectralTest(65539, 2147483648, 4)
    var ra: int128 = 65539
    var rm: int128 = 2147483648
    var plane: int128 = (9 - 6 * ra + ra * ra) % rm
    var rb3: int128 = bruteNu2(65539, 2147483648, 3, randu[1])
    print("RANDU: nu3^2 = ${randu[1]} (brute ${rb3}), 9 - 6a + a^2 mod m = ${plane}")   # 118 (brute 118), 0

    # Vol. 4B §7.2.2.1, Algorithm C on Knuth's colored example: primary p q r, secondary x y,
    # colors A = 1, B = 2. Options: 'p q x y:A', 'p r x:A y', 'p x:B', 'q x:A', 'r y:B'.
    # The one solution is 'p r x:A y' with 'q x:A' -- x used twice, both times as A.
    var kc = ExactCover(3, 2)
    kc.addColoredOption([1, 2, 4, 5], [0, 0, 0, 1])
    kc.addColoredOption([1, 3, 4, 5], [0, 0, 1, 0])
    kc.addColoredOption([1, 4], [0, 2])
    kc.addColoredOption([2, 4], [0, 1])
    kc.addColoredOption([3, 5], [0, 2])
    print("colored example: ${kc.solutions(0)}")                    # [[1, 3]]

    # Algorithm C against exhaustive search on 50 generated problems: 4 primary items,
    # 2 secondary, 10-12 options, colors 0..2.
    var cg = RanArray(271828)
    var c_agree: int = 0
    var c_total_sol: int = 0
    for trial in 0 : 50
        var nopt: int = 10 + cg.next() % 3
        var opts: List(List(int)) = List(List(int))()
        var cols: List(List(int)) = List(List(int))()
        var ec = ExactCover(4, 2)
        for o in 0 : nopt
            var its = List(int)()
            var cs = List(int)()
            for it in 1 : 5                  # each primary with probability 1/3
                if cg.next() % 3 == 0
                    its.add(it)
                    cs.add(0)
            if its.count() == 0
                its.add(1 + cg.next() % 4)
                cs.add(0)
            for it in 5 : 7                  # each secondary with probability 1/2, color 0..2
                if cg.next() % 2 == 0
                    its.add(it)
                    cs.add(cg.next() % 3)
            opts.add(its)
            cols.add(cs)
            ec.addColoredOption(its, cs)
        var got: int = ec.solutions(0).count()
        c_total_sol += got
        if got == bruteColored(4, 6, opts, cols)
            c_agree += 1
    print("colored vs brute force: ${c_agree}/50 agree (${c_total_sol} solutions in all)")

    # Vol. 4A 7.2.1.3, Algorithm L against the bitmasks with t bits set, in increasing order
    # (colex order IS increasing bitmask order), for every 1 <= t <= n <= 10.
    var comb_ok: int = 0
    var comb_all: int = 0
    for n in 1 : 11
        for t in 1 : n + 1
            comb_all += 1
            var got = combinations(n, t)
            var masks = List(int)()
            for mask in 0 : (1 << n)
                var bits: int = 0
                for bi in 0 : n
                    if ((mask >> bi) & 1) == 1
                        bits += 1
                if bits == t
                    masks.add(mask)
            var same: bool = got.count() == masks.count()
            if same
                for k in 0 : got.count()
                    var mk: int = 0
                    for e in got[k]
                        mk += (1 << e)
                    if mk != masks[k]
                        same = false
            if same
                comb_ok += 1
    print("combinations vs bitmasks: ${comb_ok}/${comb_all}, C(10,5) = ${combinations(10, 5).count()}")   # 55/55, 252

    # Vol. 2 4.3.1, Algorithm D. Base 2^8, 3000 random divisions small enough for int128;
    # step D6 is rare (about 2/b of the time), so the count of add-backs is printed -- the
    # path must actually have run for the agreement to cover it.
    var dg = RanArray(161803)
    var d_ok: int = 0
    var d_addbacks: int = 0
    for trial in 0 : 3000
        var n: int = 2 + dg.next() % 4
        var m: int = dg.next() % 7
        var v = List(int)()
        for i in 0 : n
            v.add(dg.next() % 256)
        if v[n - 1] == 0
            v[n - 1] = 1 + dg.next() % 255
        var u = List(int)()
        for i in 0 : m + n
            u.add(dg.next() % 256)
        var res = mpDivide(u, v, 256)
        d_addbacks += res[2][0]
        var uv: int128 = mpValue(u, 256)
        var vv: int128 = mpValue(v, 256)
        if mpValue(res[0], 256) == uv / vv and mpValue(res[1], 256) == uv % vv
            d_ok += 1
    # Base 2^16, 300 divisions too large for int128: u = q v + r and r < v.
    var big_ok: int = 0
    for trial in 0 : 300
        var n: int = 2 + dg.next() % 10
        var m: int = dg.next() % 20
        var v = List(int)()
        for i in 0 : n
            v.add(dg.next() % 65536)
        if v[n - 1] == 0
            v[n - 1] = 1 + dg.next() % 65535
        var u = List(int)()
        for i in 0 : m + n
            u.add(dg.next() % 65536)
        var res = mpDivide(u, v, 65536)
        var back = mpAdd(mpMul(res[0], v, 65536), res[1], 65536)
        if mpCompare(back, u) == 0 and mpCompare(res[1], v) < 0
            big_ok += 1
    print("division: ${d_ok}/3000 vs int128 (${d_addbacks} add-backs), ${big_ok}/300 by u = qv + r")
